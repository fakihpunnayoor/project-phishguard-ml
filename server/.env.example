# PhishGuard Server Configuration
PORT=5000
NODE_ENV=development

# Redis Configuration (Defaults to local or memory fallback)
REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL=3600

# MongoDB Configuration (Defaults to local or in-memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/phishguard

# Rate Limiter Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
